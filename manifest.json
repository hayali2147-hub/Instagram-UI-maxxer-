{
  "manifest_version": 3,
  "name": "Instagram UI Maxer!",
  "version": "1.0.0",
  "description": "A prototype Chrome extension that stores a token you provide for your own testing workflow.",

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "cookies"
  ],

  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.instagram.com/*"
  ],

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "action": {
    "default_title": "Instagram UI Maxer!",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  }
}